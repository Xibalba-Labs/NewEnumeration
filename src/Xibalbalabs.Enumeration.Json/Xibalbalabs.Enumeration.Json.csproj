<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0'">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xibalbalabs.Enumeration.Json</PackageId>
    <Title>System.Text.Json support for Xibalbalabs.Enumeration</Title>
    <Description>System.Text.Json converters for Xibalbalabs.Enumeration smart enums, with Native AOT support.</Description>
    <PackageTags>enumeration;enum;smart-enum;json;system.text.json;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xibalbalabs.Enumeration\Xibalbalabs.Enumeration.csproj" />
  </ItemGroup>

</Project>

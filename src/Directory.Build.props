<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Xibalba Labs</Authors>
    <Company>Xibalba Labs</Company>
    <Copyright>Copyright (c) 2026 Xibalba Labs</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Xibalba-Labs/NewEnumeration</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Xibalba-Labs/NewEnumeration.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Each packable project ships the README.md found in its own folder. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Xibalbalabs.Enumeration.EntityFrameworkCore</PackageId>
    <Title>Entity Framework Core value converters for Xibalbalabs.Enumeration</Title>
    <Description>ValueConverter implementations that map Xibalbalabs.Enumeration smart enums to/from their underlying value or display name for Entity Framework Core.</Description>
    <PackageTags>enumeration;enum;smart-enum;entityframeworkcore;efcore;value-converter</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xibalbalabs.Enumeration\Xibalbalabs.Enumeration.csproj" />
  </ItemGroup>

</Project>

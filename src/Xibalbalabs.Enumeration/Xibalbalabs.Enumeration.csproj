<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0'">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0660;CS0661</NoWarn>
  </PropertyGroup>
	<PropertyGroup>
		<PackageId>Xibalbalabs.Enumeration</PackageId>
		<Title>Xibalbalabs.Enumeration - Modern Smart Enums for .NET</Title>
		<Description>A high-performance, modern .NET Standard 2.0 / .NET 9 smart enum library and drop-in replacement for legacy enumeration packages. Supports System.Text.Json, Native AOT and EF Core with backward-compatible APIs.</Description>
		<PackageTags>enumeration;enum;smart-enum;strongly-typed-enum;domain-driven-design;ddd;value-object;legacy-replacement</PackageTags>
	</PropertyGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0'">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0660;CS0661</NoWarn>
  </PropertyGroup>
	<PropertyGroup>
		<PackageId>Xibalbalabs.Enumeration</PackageId>
		<Title>Modern Enumeration (Headspring.Enumeration Drop-in Replacement)</Title>
		<Description>A high-performance, modern .NET Standard 2.0 / .NET 9 replacement for the legacy Headspring.Enumeration library. Supports System.Text.Json, Native AOT, and EF Core with 100% backward compatibility.</Description>
		<PackageTags>headspring;enumeration;enum;smart-enum;strongly-typed-enum;domain-driven-design;ddd;value-object;legacy-replacement</PackageTags>
	</PropertyGroup>
</Project>
